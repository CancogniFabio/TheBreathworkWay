# The Breathwork Way, sito statico su GreenGeeks (Apache)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# tutto su https://www.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.thebreathworkway.com/$1 [R=301,L]

# vecchi indirizzi WordPress: ?p=123, ?page_id=, ?s= -> home
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|s|attachment_id)= [NC]
RewriteRule ^$ https://www.thebreathworkway.com/? [R=301,L]
</IfModule>

# pagine con un nome nuovo (301 = Google passa il posizionamento al nuovo indirizzo)
Redirect 301 /cookie-policy-copy/ https://www.thebreathworkway.com/privacy-policy/
Redirect 301 /contact-copy/ https://www.thebreathworkway.com/cookies-policy/
Redirect 301 /terms-conditions-2/ https://www.thebreathworkway.com/terms-conditions/
Redirect 301 /behind-the-guild-of-slowing-down/ https://www.thebreathworkway.com/behind-the-guilt-of-slowing-down/
Redirect 301 /offerings/ https://www.thebreathworkway.com/breathwork-lisbon/

# resti di WordPress
RedirectMatch 301 ^/sitemap_index\.xml$ https://www.thebreathworkway.com/sitemap.xml
RedirectMatch 301 ^/wp-sitemap.*\.xml$ https://www.thebreathworkway.com/sitemap.xml
RedirectMatch 301 ^/[a-z0-9-]+-sitemap[0-9]*\.xml$ https://www.thebreathworkway.com/sitemap.xml
RedirectMatch 301 ^/(category|tag|author)/.*$ https://www.thebreathworkway.com/insights/
RedirectMatch 301 ^/(comments/)?feed/?$ https://www.thebreathworkway.com/insights/
RedirectMatch 301 ^/([a-z0-9-]+)/feed/?$ https://www.thebreathworkway.com/$1/
RedirectMatch 410 ^/(wp-admin|wp-login\.php|xmlrpc\.php|wp-json)
# file del repo che non devono essere pubblici (se per errore vengono caricati)
RedirectMatch 404 ^/(tools|golive|dist|README\.md|\.git)

# sicurezza
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# velocità: compressione e cache
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_mime.c>
AddType font/woff2 .woff2
</IfModule>
